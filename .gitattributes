# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell scripts must always use LF
*.sh text eol=lf

# PowerShell scripts can use CRLF on Windows
*.ps1 text eol=crlf

# Batch files need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Rust source files
*.rs text eol=lf
*.toml text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf

# Markdown and documentation
*.md text eol=lf
*.txt text eol=lf

# Binary files - no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary
*.tar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
